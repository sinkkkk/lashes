# Copy this file to .env.local (for your computer) and fill in the values.
# On Vercel, add the same values under Project → Settings → Environment Variables.

# --- Required ---------------------------------------------------------------
# Supabase → green "Connect" button → Connection String → Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Your admin password for /admin
ADMIN_PASSWORD=change-me
# Any random text, 32+ characters (e.g. run: openssl rand -base64 32)
AUTH_SECRET=
# Where new-booking emails go
OWNER_EMAIL=you@example.com
# Your site address, no slash at the end
NEXT_PUBLIC_SITE_URL=https://liisulashes.ee

# --- Business details shown on the site --------------------------------------
NEXT_PUBLIC_BUSINESS_NAME=Liisu Lashes
NEXT_PUBLIC_ADDRESS=Street 1, Tallinn
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/yourname

# --- Email (resend.com) ------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Liisu Lashes <broneering@liisulashes.ee>

# --- Daily reminders and review requests (Vercel sets this up automatically) --
CRON_SECRET=

# --- Google Calendar (optional; Apple Calendar needs nothing) ----------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary

# --- Instant phone notifications (free ntfy app) ---------------------------
# A secret topic name you also subscribe to in the ntfy app, e.g. hilleliis-a1b2c3d4e5f6
NTFY_TOPIC=

# --- SMS through messente.com (phase 2, optional) ----------------------------
MESSENTE_USER=
MESSENTE_PASSWORD=
MESSENTE_SENDER=LiisuLashes
# Your own phone, to get an SMS for each new booking
NEXT_PUBLIC_PHONE=
