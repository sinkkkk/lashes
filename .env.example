# Copy this file to .env.local (for your computer) and fill in the values.
# On Cloudflare, add the same values under Workers & Pages → (your worker) → Settings → Variables and Secrets.
# (For `npm run cf:preview` on your computer, put them in .dev.vars instead.)

# --- Required ---------------------------------------------------------------
# Supabase → green "Connect" button → Connection String → Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Your admin password for /admin
ADMIN_PASSWORD=change-me
# Any random text, 32+ characters (e.g. run: openssl rand -base64 32)
AUTH_SECRET=
# Where new-booking emails go
OWNER_EMAIL=you@example.com
# Your site address, no slash at the end (optional: defaults to https://hilleliis.ee)
SITE_URL=https://hilleliis.ee

# --- Business details shown on the site --------------------------------------
BUSINESS_NAME=Lashes by Hille Liis
# Full street address: private, only in confirmation emails, calendar entries and the client's booking page
ADDRESS=Street 1, Tallinn
# Public area shown on the website instead of the address
AREA=Tallinn, Nõmme
INSTAGRAM_URL=https://instagram.com/yourname

# --- Email (resend.com) ------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Lashes by Hille Liis <broneering@hilleliis.ee>

# --- Daily reminders and review requests (any random text; the daily job sends it) --
CRON_SECRET=

# --- Google Calendar (optional; Apple Calendar needs nothing) ----------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary

# --- Instant phone notifications (free ntfy app) ---------------------------
# A secret topic name you also subscribe to in the ntfy app, e.g. hilleliis-a1b2c3d4e5f6
NTFY_TOPIC=

# --- SMS through messente.com (phase 2, optional) ----------------------------
MESSENTE_USER=
MESSENTE_PASSWORD=
MESSENTE_SENDER=LiisuLashes
# Your own phone, to get an SMS for each new booking
PHONE=
